# Discord Developer Portal → tu aplicación
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: ID de tu servidor de pruebas (los comandos aparecen al instante)
DEV_GUILD_ID=

LOG_LEVEL=info
EPIC_LOCALE=es-ES
EPIC_COUNTRY=ES
# Hora diaria (HH:MM, hora de Madrid) a la que se consultan Epic, Drops y Pick'em
DAILY_RUN_TIME=18:00
